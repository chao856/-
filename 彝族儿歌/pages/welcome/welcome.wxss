:root {
    --primary: #6A5ACD; /* 柔和蓝紫色 */
    --background: #F8F9FA; /* 浅灰白背景 */
    --accent: #FF6B6B; /* 活力珊瑚色 */
    --light-primary: #9370DB; /* 浅蓝紫 */
}

.welcome-page {
    font-family: 'Arial', sans-serif;
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--background);
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><path d="M10,10 Q20,5 30,10 Q40,15 50,10 Q60,5 70,10 Q80,15 90,10" stroke="%234B0082" fill="none" stroke-width="1" opacity="0.2"/></svg>');
    background-size: 200px 200px;
    background-repeat: repeat;
    color: #333;
}

.welcome-container {
    max-width: 800rpx;
    padding: 60rpx 40rpx;
    text-align: center;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 16rpx;
    box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.15);
    border: 1rpx solid rgba(75, 0, 130, 0.15);
    backdrop-filter: blur(8rpx);
}

.title {
    color: var(--primary);
    text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
    margin: 0 0 40rpx 0;
    font-size: 36rpx;
    font-weight: bold;
    letter-spacing: 2rpx;
}

.desc {
    color: var(--accent); /* 使用活力珊瑚色作为描述文字 */
    line-height: 1.8;
    margin-bottom: 50rpx;
    font-size: 26rpx;
    padding: 0 20rpx;
}

.enter-btn {
    width: 80%;
    max-width: 600rpx;
    height: 80rpx;
    margin: 0 auto;
    padding: 15rpx 30rpx;
    font-size: 28rpx;
    background: linear-gradient(135deg, var(--primary), var(--light-primary));
    border-radius: 24rpx; /* 更圆润的边角 */
    letter-spacing: 1rpx; /* 按钮文字间距 */
    color: white;
    border: none;
    border-radius: 40rpx;
    cursor: pointer;
    box-shadow: 0 6rpx 12rpx rgba(106, 90, 205, 0.2); /* 主色阴影 */
    transition: all 0.3s;
}

.enter-btn:hover {
    transform: translateY(-2rpx) scale(1.02); /* 悬停时轻微放大 */
    box-shadow: 0 6rpx 12rpx rgba(0,0,0,0.2);
}